# ─────────────────────────────────────────────────────────────
# Pelotea — variables de entorno (copiá a .env y completá)
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
APP_BASE_URL=http://localhost:3000
# Todo el cálculo de horarios usa Date local ingenuo (setHours/setMinutes),
# asumiendo hora de Venezuela — sin esto, un servidor en otra zona horaria
# (cualquier hosting fuera de VE) corre el horario configurado varias horas.
TZ=America/Caracas

# ── Base de datos ────────────────────────────────────────────
# En local usá el docker-compose de infra/.
# En PRODUCCIÓN: usar un rol de app de privilegio mínimo (ver
# packages/db/prisma/roles.sql, NUNCA el superusuario de postgres),
# sslmode=require, y limitar el pool para que un pico de tráfico no agote
# las conexiones de Postgres (connection_limit bajo + pgbouncer si escala).
DATABASE_URL=postgresql://pelotea:pelotea@localhost:5432/pelotea?schema=public&connection_limit=10&pool_timeout=10
# DATABASE_URL_PROD_EJEMPLO=postgresql://pelotea_app:CAMBIA_ESTO@db-interno:5432/pelotea?schema=public&sslmode=require&connection_limit=15&pool_timeout=10

# ── Redis (locks de slot, colas BullMQ, pub/sub) ─────────────
REDIS_URL=redis://localhost:6379

# ── Almacenamiento de comprobantes (MinIO / S3) ──────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=pelotea
S3_SECRET_KEY=pelotea-secret
S3_BUCKET=pelotea-comprobantes
S3_FORCE_PATH_STYLE=true
# Días que se guarda un comprobante después de aprobarse/rechazarse antes de
# que el worker lo borre del bucket (job limpieza-comprobantes).
COMPROBANTE_RETENCION_DIAS=90

# ── Auth (Better Auth) ───────────────────────────────────────
# Generá con: openssl rand -base64 32
AUTH_SECRET=changeme-genera-uno-de-verdad
AUTH_URL=http://localhost:3000

# ── Web Push (ofertas / descuentos) ──────────────────────────
# Generá con: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=
WEB_PUSH_CONTACT=mailto:soporte@pelotea.app

# ── WhatsApp (Baileys — SOLO transaccional) ──────────────────
WHATSAPP_SESSION_DIR=./apps/worker/.wa-session
WHATSAPP_ADMIN_NUMBER=
# Requerido para que el worker sirva el QR de emparejamiento en `GET /qr`
# (su propio servidor HTTP) — sin esto el endpoint queda deshabilitado.
# Generá con: openssl rand -hex 16
WHATSAPP_QR_TOKEN=

# ── Email (respaldo de notificaciones) ───────────────────────
RESEND_API_KEY=
EMAIL_FROM=Pelotea <hola@pelotea.app>

# ── Backups (Backblaze B2) ───────────────────────────────────
BACKUP_B2_KEY_ID=
BACKUP_B2_APP_KEY=
BACKUP_B2_BUCKET=

# ── Observabilidad ───────────────────────────────────────────
SENTRY_DSN=

# ── MVP single-tenant: la sede activa ────────────────────────
# Hasta que exista alta multi-complejo, la app opera sobre esta sede.
DEFAULT_SEDE_SLUG=club-piloto
